#!/bin/sh
# Fast checks on what is being committed. Enable with: make hooks   (skip once with: git commit --no-verify)
set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR)

go_files=$(printf '%s\n' "$staged" | grep '\.go$' || true)
if [ -n "$go_files" ]; then
	# shellcheck disable=SC2086 # word splitting is intended; file names have no spaces
	unformatted=$(gofmt -l $go_files)
	if [ -n "$unformatted" ]; then
		echo "pre-commit: these files need gofmt (run: gofmt -w <file>):" >&2
		echo "$unformatted" >&2
		exit 1
	fi
	go vet ./...
fi

if printf '%s\n' "$staged" | grep -qx 'install.sh'; then
	if command -v shellcheck >/dev/null; then
		shellcheck install.sh
	else
		echo "pre-commit: shellcheck not installed, skipping install.sh (CI will still check it)" >&2
	fi
fi
