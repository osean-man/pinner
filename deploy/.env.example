# DNS name pointing at this server; Caddy gets a TLS certificate for it automatically.
PINNER_DOMAIN=pins.example.com
# Maximum number of accounts (0 = unlimited). Set to 1 for a personal server.
PINNER_MAX_USERS=1
# Server image version from ghcr.io/osean-man/pinner-server: a full version (1.0.0) to pin exactly,
# or a major version (1) to follow compatible updates on `docker compose pull`.
PINNER_VERSION=1
